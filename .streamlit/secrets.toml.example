# Copy to .streamlit/secrets.toml for local runs, or paste these keys into
# Streamlit Cloud under Settings -> Secrets. NEVER commit secrets.toml.

ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: pre-created Managed Agent + Environment IDs. If omitted, the app
# creates them on first run and caches in process memory.
# MANAGED_AGENT_ID = "agent_..."
# MANAGED_ENVIRONMENT_ID = "env_..."
